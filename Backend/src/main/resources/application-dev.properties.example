# ============================================================
# SETUP: Copy this file to application-dev.properties
#        and fill in your own values. Never commit the real file.
# ============================================================

# --- Local PostgreSQL (each developer uses their own local DB) ---
spring.datasource.url=jdbc:postgresql://localhost:5432/smarthouse
spring.datasource.username=postgres
spring.datasource.password=YOUR_LOCAL_POSTGRES_PASSWORD
spring.datasource.driver-class-name=org.postgresql.Driver

# --- AWS RDS (shared team DB — get connection details from team lead) ---
#spring.datasource.url=jdbc:postgresql://REPLACE_WITH_RDS_ENDPOINT:5432/postgres
#spring.datasource.username=REPLACE_WITH_RDS_USERNAME
#spring.datasource.password=REPLACE_WITH_RDS_PASSWORD
#spring.datasource.driver-class-name=org.postgresql.Driver

spring.jpa.hibernate.ddl-auto=update

# --- JWT (get the shared dev secret from the team — do NOT invent your own) ---
jwt.secret=REPLACE_WITH_SHARED_JWT_SECRET
jwt.expiration-ms=900000
jwt.refresh-expiration-ms=604800000

# --- Email (AWS SES SMTP - eu-north-1) ---
# Go to AWS Console → SES → SMTP Settings → Create SMTP Credentials
# Note: SMTP username/password are different from your IAM access keys
spring.mail.host=email-smtp.eu-north-1.amazonaws.com
spring.mail.port=587
spring.mail.username=REPLACE_WITH_SES_SMTP_USERNAME
spring.mail.password=REPLACE_WITH_SES_SMTP_PASSWORD
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.starttls.enable=true
app.base-url=http://localhost:20025
app.mail.from=REPLACE_WITH_SES_VERIFIED_SENDER_EMAIL

# --- Google OAuth2 (uncomment and fill when credentials are ready) ---
#spring.security.oauth2.client.registration.google.client-id=REPLACE_WITH_GOOGLE_CLIENT_ID
#spring.security.oauth2.client.registration.google.client-secret=REPLACE_WITH_GOOGLE_CLIENT_SECRET
#spring.security.oauth2.client.registration.google.scope=email,profile
#spring.security.oauth2.client.registration.google.redirect-uri={baseUrl}/login/oauth2/code/google

